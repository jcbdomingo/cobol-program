       IDENTIFICATION DIVISION.
       PROGRAM-ID. SAMPLE.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INFILE  ASSIGN TO "BSITIN2.TXT"
           ORGANIZATION IS LINE SEQUENTIAL.
           SELECT OUTFILE ASSIGN TO "BSITOUT2.TXT"
           ORGANIZATION IS LINE SEQUENTIAL.
        
       DATA DIVISION.
       FILE SECTION.
       FD INFILE.
       01 INREC.
           05 STUDNUM PIC XXXX.
           05 STUDNAME PIC X(20).
           05 MID PIC 9V99.
           05 FIN PIC 9V99.
          
       FD OUTFILE.
       01  OUTREC PIC X(90).

       WORKING-STORAGE SECTION.

       01 WORKING-DETAILS. 
           05 EOFSW PIC 9 VALUE ZERO.
           05 AVE PIC 99V99 VALUE ZERO.

       01 STUD-OUT.
           05 FILLER PIC X(5) VALUE SPACES.
           05 STUDNUM-OUT PIC XXXX VALUE SPACES.
           05 FILLER PIC X(5) VALUE SPACES.
           05 STUDNAME-OUT PIC X(20) VALUE SPACES.
           05 FILLER PIC X(5) VALUE SPACES.
           05 MID-OUT PIC 9.99 VALUE ZERO.
           05 FILLER PIC X(5) VALUE SPACES.
           05 FIN-OUT PIC 9.99 VALUE SPACES.
           05 FILLER PIC X(5) VALUE SPACES.
           05 AVE-OUT PIC Z9.99 VALUE SPACES.

       01 HDG-1.
           05 FILLER PIC X(20) VALUE SPACES.
           05 FILLER PIC X(41) VALUE "POLYTECHNIC UNIVERSITY OF THE PHIL
      -    "IPPINES".
           05 FILLER PIC X(19) VALUE SPACES.

       01 HDG-2.
           05 FILLER PIC X(32) VALUE SPACES.
           05 FILLER PIC X(17) VALUE "STA. MESA, MANILA".
           05 FILLER PIC X(31) VALUE SPACES.

       01 HDG-3.
           05 FILLER PIC X(5) VALUE SPACES.
           05 FILLER PIC X(14) VALUE "STUDENT NUMBER".
           05 FILLER PIC X(5) VALUE SPACES.
           05 FILLER PIC X(12) VALUE "STUDENT NAME".
           05 FILLER PIC X(5) VALUE SPACES.
           05 FILLER PIC X(13) VALUE "MIDTERM GRADE".
           05 FILLER PIC X(5) VALUE SPACES.
           05 FILLER PIC X(11) VALUE "FINAL GRADE".
           05 FILLER PIC X(5) VALUE SPACES.
           05 FILLER PIC X(13) VALUE "AVERAGE GRADE".


       SCREEN SECTION.
       01 SCRN.
           05 BLANK SCREEN.


       PROCEDURE DIVISION.
       MAIN-RTN.
           PERFORM INITIAL-RTN.
           PERFORM PROCESS-RTN UNTIL EOFSW = 1.
           PERFORM FINAL-RTN.
           STOP RUN.

       INITIAL-RTN.
      *    DISPLAY SCRN.
           OPEN INPUT INFILE.
           OPEN OUTPUT OUTFILE.
           READ INFILE AT END MOVE 1 TO EOFSW.
           IF EOFSW = 1
               DISPLAY "NO RECORD!"
           ELSE
               PERFORM HEADING-RTN
           END-IF.

       HEADING-RTN.
           WRITE OUTREC FROM HDG-1.
           WRITE OUTREC FROM HDG-2.
           WRITE OUTREC FROM HDG-3.

       PROCESS-RTN.
           COMPUTE AVE = (MID + FIN) / 2. 
           MOVE STUDNUM TO STUDNUM-OUT.
           MOVE STUDNAME TO STUDNAME-OUT. 
           MOVE MID TO MID-OUT. 
           MOVE FIN TO FIN-OUT. 
           MOVE AVE TO AVE-OUT. 

           DISPLAY "STUDENT NUMBER: "  STUDNUM-OUT.
           DISPLAY "STUDENT NAME: " STUDNAME-OUT.
           DISPLAY "MIDTERM GRADE: " MID-OUT.
           DISPLAY "FINAL GRADE: " FIN-OUT.
           DISPLAY "AVERAGE GRADE: " AVE-OUT.

           WRITE OUTREC FROM STUD-OUT.
           READ INFILE AT END MOVE 1 TO EOFSW.
           IF EOFSW = 1
              DISPLAY "END OF FILE NO MORE RECORDS! "
           END-IF.

       FINAL-RTN.
           CLOSE INFILE, OUTFILE.
     
  
        
